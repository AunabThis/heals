<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#F5F0E6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <TextView
            android:id="@+id/detailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glamora"
            android:textSize="45sp"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="50dp"
            android:textColor="#4C020F"
            android:textStyle="bold"
            android:fontFamily="@font/le_french"
            />
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="60dp"
            android:layout_marginLeft="250dp"
            android:src="@drawable/magnifying_glass"

            />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="60dp"
            android:layout_marginLeft="300dp"
            android:src="@drawable/svg_326494"

            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textSize="15sp"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="110dp"
            android:textColor="#4C020F"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New In"
            android:textSize="15sp"
            android:layout_marginLeft="80dp"
            android:layout_marginTop="110dp"
            android:textColor="#4C020F"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="shop"
            android:textSize="15sp"
            android:layout_marginLeft="150dp"
            android:layout_marginTop="110dp"
            android:textColor="#4C020F"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="collections"
            android:textSize="15sp"
            android:layout_marginLeft="200dp"
            android:layout_marginTop="110dp"
            android:textColor="#4C020F"
            />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About"
            android:textSize="15sp"
            android:layout_marginLeft="290dp"
            android:layout_marginTop="110dp"
            android:textColor="#4C020F"
            />
        <androidx.cardview.widget.CardView
            android:layout_width="220dp"
            android:layout_height="350dp"
            android:layout_marginLeft="150dp"
            android:layout_marginTop="150dp"
            app:cardCornerRadius="30dp"
            >
            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/src1"
                />
        </androidx.cardview.widget.CardView>


        <TextView
            android:layout_width="90dp"
            android:layout_height="30dp"
            android:text="New Arrival"
            android:textSize="15sp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="180dp"
            android:textColor="#4C020F"
            />


        <TextView
            android:id="@+id/collectionName"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:text="Heels"
            android:textSize="25sp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="210dp"
            android:textColor="#4C020F"
            />
        <TextView
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="Step into elegance with our
premium quality heels for style"
            android:textSize="10sp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="250dp"
            android:textColor="#4C020F"
            />

        <TextView
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="perfect for every ocassion"
            android:textSize="15sp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="300dp"
            android:textColor="#4C020F"
            />
        <TextView
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:text="$250"
            android:textSize="20sp"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="340dp"
            android:textColor="#4C020F"
            />
        <!-- QUANTITY BOX -->
        <LinearLayout
            android:id="@+id/quantityLayout"
            android:layout_width="100dp"
            android:layout_height="60dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="375dp"
            android:background="@drawable/quantitybg"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- MINUS -->
            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="−"
                android:textColor="#17100F"
                android:textSize="28sp" />

            <!-- QUANTITY -->
            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="#17100F"
                android:textSize="22sp" />

            <!-- PLUS -->
            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#17100F"
                android:textSize="30sp" />

        </LinearLayout>


        <!-- ADD TO CART BUTTON -->

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="130dp"
            android:layout_height="76dp"
            android:layout_marginTop="446dp"
            android:backgroundTint="#4C020F"
            android:gravity="center"
            android:layout_marginStart="10dp"
            android:text="Add to Cart"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- FEATURES CARD -->
        <LinearLayout
            android:id="@+id/featuresCard"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:layout_marginTop="490dp"
            android:backgroundTint="#F5F0E6"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- FREE SHIPPING -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/delivery_truck"
                    android:contentDescription="Free Shipping" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Free Shipping"
                    android:textColor="#4C020F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Orders over $100"
                    android:textColor="#4C020F"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- SECURE PAYMENT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/data_privacy_shield"
                    android:contentDescription="Secure Payment" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Secure Payment"
                    android:textColor="#4C020F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="100% Secure"
                    android:textColor="#4C020F"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- 24/7 SUPPORT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/headset"
                    android:contentDescription="24/7 Support" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="24/7 Support"
                    android:textColor="#4C020F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="We're here to help"
                    android:textColor="#4C020F"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>