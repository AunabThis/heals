<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSignup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F8F2E8"
                />
            <TextView
                android:id="@+id/accounttv"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:text="Create an account"
                android:textStyle="bold"
                android:textSize="15sp"
                android:gravity="center"

                android:textColor="@color/white"
                android:background="@drawable/shape1"
                android:layout_marginTop="110dp"
                android:layout_marginEnd="25dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/username"
                android:layout_width="240dp"
                android:layout_height="70dp"
                android:layout_marginTop="40dp"
                android:textColor="#4C020F"
                app:hintTextColor="#4C020F"
                android:textColorHint="#4C020F"
                android:textSize="20sp"
                app:endIconMode="password_toggle"
                app:endIconTint="#4C020F"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#4C020F"
                app:layout_constraintTop_toBottomOf="@+id/accounttv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etusername"
                    android:layout_width="230dp"
                    android:layout_height="60dp"
                    android:hint="User Name"
                    android:textColor="#4C020F"
                    android:textColorHint="#4C020F"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/signuptv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent "/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email"
                android:layout_width="240dp"
                android:layout_height="70dp"
                android:layout_marginTop="15dp"
                android:textColor="#4C020F"
                android:textColorHint="#4C020F"
                android:textSize="20sp"
                app:endIconMode="password_toggle"
                app:endIconTint="#4C020F"
                app:hintTextColor="#4C020F"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#4C020F"
                app:layout_constraintTop_toBottomOf="@id/username"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etemail"
                    android:layout_width="230dp"
                    android:layout_height="60dp"
                    android:hint="Email"
                    android:textColor="#4C020F"
                    android:textColorHint="#4C020F"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@+id/username"
                    app:layout_constraintStart_toStartOf="parent"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password"
                android:layout_width="240dp"
                android:layout_height="70dp"
                android:layout_marginTop="15dp"
                android:textColor="#4C020F"
                android:textColorHint="#4C020F"
                android:textSize="20sp"
                app:hintTextColor="#4C020F"
                app:endIconMode="password_toggle"
                app:endIconTint="#4C020F"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#4C020F"
                app:layout_constraintTop_toBottomOf="@id/email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etpassword"
                    android:layout_width="230dp"
                    android:layout_height="60dp"
                    android:hint="Password"
                    android:textColor="#4C020F"
                    android:textColorHint="#4C020F"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@+id/email"
                    app:layout_constraintStart_toStartOf="parent"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirmpassword"
                android:layout_width="240dp"
                android:layout_height="70dp"
                android:layout_marginTop="15dp"
                app:hintTextColor="#4C020F"
                android:textColor="#4C020F"
                android:textColorHint="#4C020F"
                android:textSize="20sp"
                app:endIconMode="password_toggle"
                app:endIconTint="#4C020F"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#4C020F"
                app:layout_constraintTop_toBottomOf="@id/password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etconfirmpassword"
                    android:layout_width="230dp"
                    android:layout_height="60dp"
                    android:hint="Confirm Password"
                    android:textColor="#4C020F"
                    android:textColorHint="#4C020F"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@+id/password"
                    app:layout_constraintStart_toStartOf="parent"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
               android:id="@+id/tvlogIn"
               android:layout_width="270dp"
               android:layout_height="50dp"
               android:text="Already have account?\n
           Sign in"
               android:textSize="15sp"
              android:gravity="center"
               android:textStyle="bold"
               android:textColor="#4C020F"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintTop_toBottomOf="@id/confirmpassword"
               />


            <Button
                android:id="@+id/signup"
                android:layout_width="130dp"
                android:layout_height="50dp"
               android:layout_marginTop="20dp"
                android:backgroundTint="#4C020F"
                android:text="Sign Up"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvlogIn"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>